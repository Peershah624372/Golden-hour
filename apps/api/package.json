{
  "name": "@gh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 --test-force-exit \"test/**/*.test.ts\"",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.mjs --log-level=warning --external:@electric-sql/pglite --external:cors --external:drizzle-orm --external:express --external:pg --external:socket.io --external:zod",
    "start:prod": "node --env-file-if-exists=../../.env dist/index.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@gh/shared": "workspace:*",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "esbuild": "~0.28.0"
  }
}
