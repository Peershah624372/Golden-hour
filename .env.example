# Copy to .env (never commit .env)

# --- Database ---------------------------------------------------------------
# Leave empty to use the built-in local Postgres (PGlite, stored in apps/api/.pglite).
# For Neon: console.neon.tech -> your project -> Connect -> copy the connection string.
DATABASE_URL=

# --- AI (any OpenAI-compatible API). Empty key = rules-only mode. -------------
# Gemini (free): get a key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Groq (free) alternative:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- API server --------------------------------------------------------------
PORT=4000
# Comma-separated allowed web origins in production, e.g. https://goldenhour.vercel.app
CORS_ORIGIN=
REPORTER_HASH_SALT=change-me
