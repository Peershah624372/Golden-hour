# Copy to .env (never commit .env). Every value is optional for local use.

# --- Database ---------------------------------------------------------------
# Leave empty to use the built-in local Postgres (PGlite, stored in apps/api/.pglite).
# For Neon: console.neon.tech -> your project -> Connect -> copy the connection string.
DATABASE_URL=

# --- AI (any OpenAI-compatible API). Empty key = rules-only mode (everything still works). ---
# Gemini (free): get a key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# LLM_TIMEOUT_MS=12000
# Groq (free) alternative:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Security: SET ALL THREE on any public deployment ---------------------------
# Signs staff sign-in tokens. Any long random string.
AUTH_SECRET=
# PIN needed to sign in to staff screens (stops visitors opening the command center or resetting the demo).
STAFF_PIN=
# Encrypts what callers typed/said and SMS bodies at rest. Any long random string. Keep it: changing it makes old text unreadable.
DATA_KEY=
# Raw text and SMS logs are deleted after this many days (statistics are kept).
RETENTION_DAYS=90
REPORTER_HASH_SALT=change-me

# --- API server --------------------------------------------------------------
PORT=4000
# Comma-separated allowed web origins in production, e.g. https://goldenhour.vercel.app
CORS_ORIGIN=
EMERGENCY_NUMBER=1122

# --- SMS (Level 2). Without Twilio, SMS is simulated in the command center. ---------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional shared secret for the inbound webhook: /api/sms/inbound?key=...
SMS_WEBHOOK_KEY=

# --- Demo simulator ----------------------------------------------------------------
# SIM_SPEEDUP=8            ambulances drive 8x faster than real time
# SIM_AUTOPILOT=true       units/ERs with no screen open act on their own
# HANDOVER_TIMEOUT_S=120   no ER answer -> next hospital
# OSRM_URL=https://router.project-osrm.org   (OSRM_URL=off -> straight-line ETAs, no network)
# SEED_HISTORY=true        load 7 days of clearly-labelled simulated history for the dashboard

# --- Web app (build time) ------------------------------------------------------------
# VITE_API_URL=https://your-api.onrender.com   (when the API is on another host)
# VITE_EMERGENCY_NUMBER=1122
# VITE_SMS_NUMBER=           number the coded SOS SMS is sent to
